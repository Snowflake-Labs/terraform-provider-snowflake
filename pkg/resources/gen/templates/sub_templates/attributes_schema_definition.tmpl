{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/pkg/resources/gen.ResourceModel*/ -}}
{{- if .Hooks.AttributesSchema.Generate }}
var {{ .Prefix }}AttributesSchema = {{ if .AttributesModification }}{{ .Prefix }}AttributesModificationExt({{ end }}map[string]*tfschema.Schema{
{{- range .Attributes }}
	{{ template "attributeSchemaEntry" . }}
{{- end }}
}{{ if .AttributesModification }}){{ end }}

{{ end -}}

{{- /* attributeSchemaEntry renders one schema field. Nested blocks call it again for each child. */ -}}
{{- define "attributeSchemaEntry" -}}
	"{{ .Name }}": {
		Type: tfschema.{{ .TfType }},
{{- if .Required }}
		Required: true,
{{- else if .Optional }}
		Optional: true,
{{- end }}
{{- if .ForceNew }}
		ForceNew: true,
{{- end }}
{{- if .MinItems }}
		MinItems: {{ .MinItems }},
{{- end }}
{{- if .MaxItems }}
		MaxItems: {{ .MaxItems }},
{{- end }}
{{- if .Children }}
		Elem: &tfschema.Resource{
			Schema: map[string]*tfschema.Schema{
{{- range .Children }}
				{{ template "attributeSchemaEntry" . }}
{{- end }}
			},
		},
{{- else if .Elem }}
		Elem: &tfschema.Schema{
			Type: tfschema.{{ .Elem.TfType }},
{{- if .Elem.ValidateDiagExpr }}
			ValidateDiagFunc: {{ .Elem.ValidateDiagExpr }},
{{- end }}
		},
{{- end }}
{{- if .ValidateDiagExpr }}
		ValidateDiagFunc: {{ .ValidateDiagExpr }},
{{- end }}
{{- if .DiffSuppressExpr }}
		DiffSuppressFunc: {{ .DiffSuppressExpr }},
{{- end }}
{{- if .ConflictsWith }}
		ConflictsWith: []string{
{{- range .ConflictsWith }}
			{{ printf "%q" . }},
{{- end }}
		},
{{- end }}
{{- if .DescriptionExpr }}
		Description: {{ .DescriptionExpr }},
{{- end }}
{{- if .DefaultExpr }}
		Default: {{ .DefaultExpr }},
{{- end }}
	},
{{- end }}
