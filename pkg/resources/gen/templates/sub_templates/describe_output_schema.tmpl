{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/pkg/resources/gen.ResourceModel*/ -}}
{{- if .Hooks.DescribeOutputSchema.Generate -}}
	map[string]*tfschema.Schema{
		DescribeOutputAttributeName: {
			Type:        tfschema.TypeList,
			Computed:    true,
			Description: "Outputs the result of `DESCRIBE {{ ToUpper (CamelToWords .Name) }}` for the given {{ CamelToWords .Name }}.{{ if .AdditionalDescribeOutputDescription }} {{ .AdditionalDescribeOutputDescription }}{{ end }}",
			Elem: &tfschema.Resource{
				Schema: schemas.Describe{{ .Name }}DetailsSchema,
			},
		},
	},
{{ else if .Hooks.DescribeOutputSchema.Present -}}
	{{ .Prefix }}DescribeOutputSchemaExt,
{{ end -}}
