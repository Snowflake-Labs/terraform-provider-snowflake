{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/pkg/resources/gen.ResourceModel*/ -}}
{{- if .Hooks.AfterAlter.Generate -}}
{{ Unimplemented "AfterAlter" }}
{{- else if .Hooks.AfterAlter.Present -}}
	afterAlterDiags := {{ .Prefix }}AfterAlterExt(ctx, d, meta, id)
	return append(afterAlterDiags, Read{{ .Name }}Func(false)(ctx, d, meta)...)
{{- else -}}
	return Read{{ .Name }}Func(false)(ctx, d, meta)
{{- end }}
