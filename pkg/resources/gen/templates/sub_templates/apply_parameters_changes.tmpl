{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/pkg/resources/gen.ResourceModel*/ -}}
{{- if .Hooks.ApplyParametersChanges.Generate -}}
	if diags := {{ .Prefix }}ApplyParametersChanges(d, setUnset.set, setUnset.unset); diags != nil {
{{- if .HasPartialOnUpdate }}
		d.Partial(true)
{{- end }}
		return diags
	}
{{ else if .Hooks.ApplyParametersChanges.Present -}}
	if diags := {{ .Prefix }}ApplyParametersChangesExt(d, setUnset); diags != nil {
{{- if .HasPartialOnUpdate }}
		d.Partial(true)
{{- end }}
		return diags
	}
{{ end -}}
