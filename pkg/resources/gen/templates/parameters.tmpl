{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/pkg/resources/gen.ResourceModel*/ -}}

var (
{{- if .Hooks.ParametersAttributesSchema.Generate }}
	{{ .Prefix }}ParametersAttributesSchema = map[string]*tfschema.Schema{
{{- range .ParameterHooks }}
		{{ printf "%q" .Parameter.FieldName }}: parameterSchemaFromDefinition(parameterSchemaDefinition{
			sqlName:     {{ printf "%q" .Parameter.SqlName }},
			kind:        {{ printf "%q" .Parameter.Kind }},
			description: {{ printf "%q" .Parameter.Description }},
		}),
{{- end }}
		}
{{- else if .Hooks.ParametersAttributesSchema.Present }}
	{{ .Prefix }}ParametersAttributesSchema = {{ .Prefix }}ParametersAttributesSchemaExt
{{- end }}
{{- if .Hooks.ParametersOutputSchema.Generate }}
	{{ .Prefix }}ParametersOutputSchema = map[string]*tfschema.Schema{
		ParametersAttributeName: {
			Type:        tfschema.TypeList,
			Computed:    true,
			Description: "Outputs the result of `SHOW PARAMETERS IN {{ ToUpper (CamelToWords .Name) }}` for the given {{ CamelToWords .Name }}.",
			Elem: &tfschema.Resource{
				Schema: schemas.Show{{ .Name }}ParametersSchema,
			},
		},
	}
{{- else if .Hooks.ParametersOutputSchema.Present }}
	{{ .Prefix }}ParametersOutputSchema = {{ .Prefix }}ParametersOutputSchemaExt
{{- end }}
{{- if .Hooks.ParametersFieldNames.Generate }}
	{{ .Prefix }}ParametersFieldNames = []string{
{{- range .ParameterHooks }}
		{{ printf "%q" .Parameter.FieldName }},
{{- end }}
	}
{{- else if .Hooks.ParametersFieldNames.Present }}
	{{ .Prefix }}ParametersFieldNames = {{ .Prefix }}ParametersFieldNamesExt
{{- end }}
{{- if .Hooks.ParametersCustomDiff.Generate }}
	{{ .Prefix }}ParametersCustomDiff = ParametersCustomDiffFromTypedParameters(
		{{ .Prefix }}ParametersProvider,
		{{ .Prefix }}ParameterDiffFunctions,
	)
{{- else if .Hooks.ParametersCustomDiff.Present }}
	{{ .Prefix }}ParametersCustomDiff = {{ .Prefix }}ParametersCustomDiffExt
{{- end }}
)
{{- if .Hooks.ParametersCustomDiff.Generate }}

func {{ .Prefix }}ParametersProvider(ctx context.Context, d ResourceIdProvider, meta any) (*sdk.{{ .Name }}ParametersDetails, error) {
	id, err := {{ .ParseIdFunc }}(d.Id())
	if err != nil {
		return nil, err
	}
	return meta.(*provider.Context).Client.{{ .NamePlural }}.ShowParametersDetails(ctx, id)
}

func {{ .Prefix }}ParameterDiffFunctions(parameters *sdk.{{ .Name }}ParametersDetails) []tfschema.CustomizeDiffFunc {
	return []tfschema.CustomizeDiffFunc{
{{- range .ParameterHooks }}
		{{ .DiffFunc }}({{ printf "%q" .Parameter.FieldName }}, parameters.{{ .Parameter.StructFieldName }}, sdk.ParameterType{{ $.Name }}),
{{- end }}
	}
}
{{- end }}
{{- if .Hooks.ApplyParametersCreate.Generate }}

func {{ .Prefix }}ApplyParametersCreate(d *tfschema.ResourceData, req *sdk.Create{{ .Name }}Request) diag.Diagnostics {
	return JoinDiags(
{{- range .ParameterHooks }}
		handleParameterCreate{{ if .NeedsMapping }}WithMapping{{ end }}(d, {{ printf "%q" .Parameter.FieldName }}, &req.{{ .Parameter.StructFieldName }}{{ if .NeedsMapping }}, {{ .Mapper }}{{ end }}),
{{- end }}
	)
}
{{- end }}
{{- if .Hooks.ApplyParametersChanges.Generate }}

func {{ .Prefix }}ApplyParametersChanges(d *tfschema.ResourceData, set *sdk.{{ .Name }}SetRequest, unset *sdk.{{ .Name }}UnsetRequest) diag.Diagnostics {
	return JoinDiags(
{{- range .ParameterHooks }}
		handleParameterUpdate{{ if .NeedsMapping }}WithMapping{{ end }}(d, {{ printf "%q" .Parameter.FieldName }}, &set.{{ .Parameter.StructFieldName }}, &unset.{{ .Parameter.StructFieldName }}{{ if .NeedsMapping }}, {{ .Mapper }}{{ end }}),
{{- end }}
	)
}
{{- end }}
{{- if .Hooks.SetParametersFields.Generate }}

func {{ .Prefix }}SetParametersFields(d *tfschema.ResourceData, parameters *sdk.{{ .Name }}ParametersDetails) diag.Diagnostics {
	return JoinDiags(
{{- range .ParameterHooks }}
		setResourceData(d, {{ printf "%q" .Parameter.FieldName }}, {{ .Read }}),
{{- end }}
	)
}
{{- end }}
