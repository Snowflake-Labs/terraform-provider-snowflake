{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/pkg/schemas/gen.ShowResultSchemaModel*/ -}}

{{- $schemaPrefix := "Show" }}
{{- $queryKind := "SHOW" }}
{{- if .IsDescribe }}
    {{- $schemaPrefix = "Describe" }}
    {{- $queryKind = "DESCRIBE" }}
{{- end }}
{{- $schemaVar := printf "%s%sSchema" $schemaPrefix .Name }}
{{- if .UsedAsListEntry }}
    {{- $schemaVar = printf "%sSchema" .Name }}
{{- end }}

{{- if .UsedAsListEntry }}
// {{ $schemaVar }} represents a single {{ .Name }} row used as a list Elem.
{{- else }}
// {{ $schemaVar }} represents output of {{ $queryKind }} query for the single {{ .Name }}.
{{- end }}
var {{ $schemaVar }} = map[string]*schema.Schema{
{{- range .SchemaFields }}
    "{{ .Name }}": {
    Type:     schema.{{ .SchemaType }},
    Computed: true,
    },
{{- end }}
}

var _ = {{ $schemaVar }}
