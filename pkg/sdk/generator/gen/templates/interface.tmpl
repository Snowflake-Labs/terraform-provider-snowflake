{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/pkg/sdk/generator/gen.Interface*/ -}}

import "context"

type {{ .Name }} interface {
	{{- range .Operations }}
		{{- if .ShowMapping }}
			{{- if .ShowKind}}
				{{- if eq (show_mapping_deref .ShowKind) "single_value" }}
					{{ .Name }}(ctx context.Context, request *{{ .OptsField.DtoDecl }}) (*{{ .ShowMapping.To.Name }}, error)
				{{- else if eq (show_mapping_deref .ShowKind) "slice" }}
					{{ .Name }}(ctx context.Context, request *{{ .OptsField.DtoDecl }}) ([]{{ .ShowMapping.To.Name }}, error)
				{{- end }}
			{{- end }}
		{{- else if eq .Name "ShowByID" }}
			{{ .Name }}(ctx context.Context, id {{ .ObjectInterface.IdentifierKind }}) (*{{ .ObjectInterface.ShowObjectName }}, error)
			{{ .Name }}Safely(ctx context.Context, id {{ .ObjectInterface.IdentifierKind }}) (*{{ .ObjectInterface.ShowObjectName }}, error)
		{{- else if and (eq .Name "Describe") .DescribeMapping }}
			{{- if .DescribeKind }}
				{{- if eq (describe_mapping_deref .DescribeKind) "single_value" }}
					{{ .Name }}(ctx context.Context, id {{ .ObjectInterface.IdentifierKind }}) (*{{ .DescribeMapping.To.Name }}, error)
				{{- else if eq (describe_mapping_deref .DescribeKind) "slice" }}
					{{ .Name }}(ctx context.Context, id {{ .ObjectInterface.IdentifierKind }}) ([]{{ .DescribeMapping.To.Name }}, error)
				{{- end }}
			{{- end }}
		{{- else if eq .Name "Drop" }}
			Drop(ctx context.Context, request *{{ .OptsField.DtoDecl }}) error
			DropSafely(ctx context.Context, id {{ .ObjectInterface.IdentifierKind }}) error
		{{- else if .InstanceMethodMapping }}
			{{- if eq (instance_method_kind_deref .InstanceMethodKind) "slice" }}
				{{ .Name }}(ctx context.Context, request *{{ .OptsField.DtoDecl }}) ([]{{ .InstanceMethodMapping.To.Name }}, error)
			{{- else }}
				{{ .Name }}(ctx context.Context, request *{{ .OptsField.DtoDecl }}) (*{{ .InstanceMethodMapping.To.Name }}, error)
			{{- end }}
		{{- else if .InstanceMethodScalarReturnType }}
			{{ .Name }}(ctx context.Context, request *{{ .OptsField.DtoDecl }}) (*{{ .InstanceMethodScalarReturnType }}, error)
		{{- else }}
			{{ .Name }}(ctx context.Context, request *{{ .OptsField.DtoDecl }}) error
		{{- end -}}
	{{ end }}
	{{- range .CustomMethods }}
		{{- if .Doc }}
			{{- range splitLines .Doc }}
			// {{ . }}
			{{- end }}
		{{- end }}
		{{ .Name }}(ctx context.Context{{ range .Parameters }}, {{ .Name }} {{ .Kind }}{{ end }}){{ if eq (len .ReturnTypes) 1 }} {{ index .ReturnTypes 0 }}{{ else if gt (len .ReturnTypes) 1 }} ({{ join .ReturnTypes ", " }}){{ end }}
	{{- end }}
}
{{ if .ParametersDetails }}
// {{ .NameSingular }}ParametersDetails holds the object's parameters with values parsed into their Go types.
type {{ .NameSingular }}ParametersDetails struct {
{{- range .ParametersDetails.Fields }}
	{{ .FieldName }} TypedParameter[{{ .GoType }}]
{{- end }}
}
{{- end }}
