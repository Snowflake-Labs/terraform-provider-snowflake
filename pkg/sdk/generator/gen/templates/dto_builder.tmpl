{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/pkg/sdk/generator/gen.Field*/ -}}

{{- $name := .DtoDecl -}}

func New{{ $name }}(
{{- range .Fields }}
    {{- if (and .ShouldBeInDto .Required) }}
        {{ FirstLetterLowercase .Name }} {{ .DtoKind }},
    {{- end }}
{{- end }}
) *{{ $name }} {
s := {{ $name }}{}
{{- range .Fields }}
    {{- if (and .ShouldBeInDto .Required) }}
        s.{{ .Name }} = {{ FirstLetterLowercase .Name }}
    {{- end }}
{{- end }}
return &s
}

{{ range .Fields }}
    {{- if (and .ShouldBeInDto (not .Required)) }}
func (s *{{ $name }}) With{{ .Name }}({{ FirstLetterLowercase .Name }}  {{ if .IsSlice }}[]{{ end }}{{ .DtoDecl }}) *{{ $name }} {
    s.{{ .Name }} = {{ if .IsPointer }}&{{ end }}{{ FirstLetterLowercase .Name }}
    return s
}
    {{- end }}
{{ end }}

{{- with .SetParameters }}
func (s *{{ $name }}) SetParameterFromRaw(key string, value string) error {
    switch key {
    {{- range . }}
    case "{{ .SqlName }}":
        return assignParsedParameter(value, {{ .Parser }}, &s.{{ .FieldName }})
    {{- end }}
    default:
        return ErrParameterNotSupported
    }
}
{{ end }}

{{- with .UnsetParameters }}
func (s *{{ $name }}) UnsetParameterFromRaw(key string) error {
    switch key {
    {{- range . }}
    case "{{ .SqlName }}":
        s.{{ .FieldName }} = Bool(true)
    {{- end }}
    default:
        return ErrParameterNotSupported
    }
    return nil
}
{{ end }}
