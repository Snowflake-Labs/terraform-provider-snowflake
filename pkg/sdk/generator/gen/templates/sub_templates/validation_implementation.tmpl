{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/pkg/sdk/generator/gen.Field*/ -}}

{{- $field := . -}}
{{- if $field.IsSlice -}}
    {{- range .Validations }}
        {{- if .IsAdditionalValidations }}
        errs = append(errs, opts{{ $field.Path }}.additionalValidations())
        {{- end }}
    {{- end }}
    {{- if $field.NeedsSliceIndexVar }}
    for {{ $field.SliceIndexVar }}, {{ $field.SliceElemVar }} := range {{ $field.AccessExpr }} {
    {{- else }}
    for _, {{ $field.SliceElemVar }} := range {{ $field.AccessExpr }} {
    {{- end }}
        {{- range $field.Validations }}
            {{- if not .IsAdditionalValidations }}
            if {{ .Condition $field }} {
                errs = append(errs, {{ .ReturnedError $field }})
            }
            {{- end }}
        {{- end -}}
        {{- range .Fields }}
            {{- if .HasAnyValidationInSubtree }}
            if valueSet({{ .AccessExpr }}) {
                {{- template "validationImplementation" . }}{{/* Recursive call */}}
            }
            {{- end -}}
        {{- end }}
    }
{{- else -}}
    {{- range .Validations }}
        {{- if .IsAdditionalValidations }}
        errs = append(errs, opts{{ $field.Path }}.additionalValidations())
        {{- else }}
            if {{ .Condition $field }} {
                errs = append(errs, {{ .ReturnedError $field }})
            }
        {{- end }}
    {{- end -}}
    {{- range .Fields }}
        {{- if .HasAnyValidationInSubtree }}
            if valueSet({{ .AccessExpr }}) {
                {{- template "validationImplementation" . }}{{/* Recursive call */}}
            }
        {{- end -}}
    {{- end -}}
{{- end -}}
